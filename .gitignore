# The kit's own working files. The installer writes a separate block into each
# target's .gitignore; this file only keeps the template clean.
__pycache__/
*.pyc
.venv/
.DS_Store

# The crate ships in tool/; its build output does not.
tool/target/

# A developer's open worktree lives here. It is a checkout, not office state,
# and can carry gigabytes of build output; the installer excludes it from a
# copy. Never commit it.
.agents/worktrees/

# `.agents/memory/archive/` is committed on purpose (it is the long-term
# memory), so it must NOT be ignored. Only transient write artefacts are.
.agents/memory/.work/
.agents/memory/.lock
.agents/memory/*.tmp

# Office state written by `zolly` at seat time; machine-local, never commit it.
.agents/zolly/state.md
.agents/zolly/auto-reports

# Never commit a token. Credentials live in ~/.config/zolly/<freq>/.
.agents/zolly/.env
.env
